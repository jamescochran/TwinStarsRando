    {
      "name": "SYZYGY campaign",
      "short_name": "SYZYGY",
      "description": "Continue your SYZYGY campaign",
      "url": "./#syzygy",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "screenshots": [
    {
